// Prisma schema for BookFlow
// Configured with PostgreSQL and UUID primary keys

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BookFormat {
  EPUB
  PDF
}

enum BookStatus {
  UNREAD
  READING
  COMPLETED
}

enum LocationType {
  EPUB_CFI
  PDF_PAGE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String    @map("display_name")
  avatarUrl    String?   @map("avatar_url")
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  books               Book[]
  readingProgress     ReadingProgress[]
  bookmarks           Bookmark[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  familyId         String        @map("family_id") @db.Uuid
  tokenHash        String        @unique @map("token_hash")
  parentTokenId    String?       @unique @map("parent_token_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  expiresAt        DateTime      @map("expires_at")
  consumedAt       DateTime?     @map("consumed_at")
  revokedAt        DateTime?     @map("revoked_at")
  revocationReason String?       @map("revocation_reason")
  userAgent        String?       @map("user_agent")
  ipAddress        String?       @map("ip_address")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentToken      RefreshToken? @relation("TokenLineage", fields: [parentTokenId], references: [id])
  childToken       RefreshToken? @relation("TokenLineage")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Book {
  id              String     @id @default(uuid()) @db.Uuid
  ownerId         String     @map("owner_id") @db.Uuid
  title           String
  author          String?
  description     String?
  language        String?
  publisher       String?
  publishedAt     DateTime?  @map("published_at")
  isbn            String?
  format          BookFormat
  coverStorageKey String?    @map("cover_storage_key")
  status          BookStatus @default(UNREAD)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  lastOpenedAt    DateTime?  @map("last_opened_at")

  owner           User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files           BookFile[]
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]

  @@index([ownerId])
  @@index([title])
  @@index([author])
  @@index([lastOpenedAt])
  @@map("books")
}

model BookFile {
  id               String   @id @default(uuid()) @db.Uuid
  bookId           String   @map("book_id") @db.Uuid
  storageKey       String   @unique @map("storage_key")
  originalFilename String   @map("original_filename")
  mimeType         String   @map("mime_type")
  sizeBytes        BigInt   @map("size_bytes")
  checksum         String?
  createdAt        DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@map("book_files")
}

model ReadingProgress {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  bookId             String       @map("book_id") @db.Uuid
  locationType       LocationType @map("location_type")
  locationValue      String       @map("location_value")
  progressPercentage Float        @default(0) @map("progress_percentage")
  currentPage        Int?         @map("current_page")
  totalPages         Int?         @map("total_pages")
  settingsJson       Json?        @map("settings_json")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@map("reading_progress")
}

model Bookmark {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  bookId             String       @map("book_id") @db.Uuid
  locationType       LocationType @map("location_type")
  locationValue      String       @map("location_value")
  progressPercentage Float        @default(0) @map("progress_percentage")
  title              String?
  note               String?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
  @@map("bookmarks")
}
