# ------------------------------------------------------------------------------
# BookFlow Environment Configuration
# ------------------------------------------------------------------------------

# General Environment
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database (PostgreSQL) - Default Docker Compose config
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=bookflow_dev_secret
POSTGRES_DB=bookflow_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bookflow:bookflow_dev_secret@localhost:5432/bookflow_dev?schema=public
DIRECT_URL=postgresql://bookflow:bookflow_dev_secret@localhost:5432/bookflow_dev?schema=public

# Security & JWT (Phase 2)
JWT_ACCESS_SECRET=bookflow_dev_access_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Storage Configuration (Phase 3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_BOOK_FILE_SIZE_MB=100

# S3 Configuration (Optional / Production)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=bookflow-books
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Frontend Web Configuration (Vite)
VITE_API_URL=http://localhost:3000/api/v1

# ==============================================================================
# SMTP Mail Delivery Settings (100% Free - Gmail, Resend, or Brevo)
# ==============================================================================
# OPTION 1: Gmail (Free - 500 emails/day, no custom domain needed)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# 3. Fill in your Gmail address and 16-character App Password below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_character_app_password
# SMTP_FROM="BookFlow <your_email@gmail.com>"

# OPTION 2: Resend (Free - 3,000 emails/month at https://resend.com)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASSWORD=re_your_api_key_here
# SMTP_FROM="BookFlow <onboarding@resend.dev>"

# OPTION 3: Local Mailpit (Default development fallback on port 1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="BookFlow <noreply@bookflow.local>"

