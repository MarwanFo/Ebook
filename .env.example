# ------------------------------------------------------------------------------
# BookFlow Environment Configuration
# ------------------------------------------------------------------------------

# General Environment
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Database (PostgreSQL) - Default Docker Compose config
POSTGRES_USER=bookflow
POSTGRES_PASSWORD=bookflow_dev_secret
POSTGRES_DB=bookflow_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bookflow:bookflow_dev_secret@localhost:5432/bookflow_dev?schema=public

# Security & JWT (Phase 2)
JWT_ACCESS_SECRET=bookflow_dev_access_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Storage Configuration (Phase 3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
MAX_BOOK_FILE_SIZE_MB=100

# S3 Configuration (Optional / Production)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=bookflow-books
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Frontend Web Configuration (Vite)
VITE_API_URL=http://localhost:3000/api/v1
